+if (utf)
+  {
+  /* Captures and dollar escapes are UTF-8. The narrow spawn API would
+  reinterpret them using the Windows ANSI code page. */
+  wchar_t **wideargs = (wchar_t **)calloc(argsvectorlen, sizeof(wchar_t *));
+  PCRE2_SIZE i = 0;
+  result = 1;
+  if (wideargs == NULL)
+    fputs("pcre2grep: failed to allocate Unicode callout arguments\n", stderr);
+  else
+    {
+    for (; argsvector[i] != NULL; i++)
+      {
+      int count = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+        argsvector[i], -1, NULL, 0);
+      if (count == 0)
+        {
+        fputs("pcre2grep: invalid UTF-8 in callout argument\n", stderr);
+        break;
+        }
+      wideargs[i] = (wchar_t *)malloc((size_t)count * sizeof(wchar_t));
+      if (wideargs[i] == NULL)
+        {
+        fputs("pcre2grep: failed to allocate Unicode callout argument\n", stderr);
+        break;
+        }
+      if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+          argsvector[i], -1, wideargs[i], count) != count)
+        {
+        fputs("pcre2grep: failed to convert Unicode callout argument\n", stderr);
+        break;
+        }
+      }
+    if (argsvector[i] == NULL)
+      result = _wspawnvp(_P_WAIT, wideargs[0],
+        (const wchar_t * const *)wideargs) != 0;
+    for (i = 0; i < argsvectorlen; i++) free(wideargs[i]);
+    free(wideargs);
+    }
+  }
+else
