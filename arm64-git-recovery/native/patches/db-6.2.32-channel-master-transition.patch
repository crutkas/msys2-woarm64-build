+struct master_transition {
+	DB_ENV *dbenv;
+	int ret;
+};
+
+static int
+try_master(void *ctx)
+{
+	struct master_transition *transition = ctx;
+	DB_ENV *dbenv = transition->dbenv;
+	DB_REP_STAT *stats;
+	int ready;
+
+	/* A successful repmgr_start can be ignored during message lockout. */
+	if ((transition->ret =
+	    dbenv->repmgr_start(dbenv, 0, DB_REP_MASTER)) != 0 ||
+	    (transition->ret = dbenv->rep_stat(dbenv, &stats, 0)) != 0)
+		return (1);
+	ready = stats->st_status == DB_REP_MASTER &&
+	    stats->st_master == stats->st_env_id;
+	free(stats);
+	return (ready);
+}
+
+static int
+become_master(DB_ENV *dbenv)
+{
+	struct master_transition transition;
+
+	transition.dbenv = dbenv;
+	transition.ret = 0;
+	if (!await_condition(try_master, &transition, 60)) {
+		dbenv->errx(dbenv, "master promotion not achieved in 60 seconds");
+		return (DB_TIMEOUT);
+	}
+	if (transition.ret != 0)
+		dbenv->err(dbenv, transition.ret, "master promotion");
+	return (transition.ret);
+}
+
