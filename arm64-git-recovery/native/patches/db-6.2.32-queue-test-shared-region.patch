+/* Shared-queue offsets require head and entries in one allocation. */
+#define QUEUE_REGION_BYTES 4096
+static unsigned char *queue_region;
+static size_t queue_used;
+
+static void *
+queue_calloc(size_t count, size_t size)
+{
+	size_t alignment = _Alignof(max_align_t);
+	size_t offset = (queue_used + alignment - 1) & ~(alignment - 1);
+	void *result;
+
+	assert(offset <= QUEUE_REGION_BYTES && size != 0 &&
+	    count <= (QUEUE_REGION_BYTES - offset) / size);
+	result = queue_region + offset;
+	queue_used = offset + count * size;
+	memset(result, 0, count * size);
+	return (result);
+}
+
+static void
+queue_free(void *pointer)
+{
+	/* Reclaim the shared backing region after the complete operation case. */
+	assert(pointer == NULL || ((unsigned char *)pointer >= queue_region &&
+	    (unsigned char *)pointer < queue_region + queue_used));
+}
