diff --git a/test/testrunner_data.tcl b/test/testrunner_data.tcl
--- a/test/testrunner_data.tcl
+++ b/test/testrunner_data.tcl
@@ -478,8 +478,25 @@
 proc make_sh_script {srcdir opts cflags makeOpts configOpts} {
 
   set tcldir [::tcl::pkgconfig get libdir,install]
+  if {[info exists ::env(SQLITE_TEST_TCL_CONFIG)]} {
+    set cfg [file normalize $::env(SQLITE_TEST_TCL_CONFIG)]
+    if {![file isfile $cfg] || [file tail $cfg] ne "tclConfig.sh"} {
+      error "SQLITE_TEST_TCL_CONFIG must name an existing tclConfig.sh"
+    }
+    set tcldir [file dirname $cfg]
+  }
+  if {[info exists ::env(SQLITE_TEST_BUILD)]} {
+    if {![regexp {^[a-zA-Z0-9_.-]+$} $::env(SQLITE_TEST_BUILD)]} {
+      error "Invalid SQLITE_TEST_BUILD triplet"
+    }
+    lappend configOpts --build=$::env(SQLITE_TEST_BUILD)
+  }
   set myopts ""
+  if {[info exists ::env(SQLITE_TEST_BUILD)] && [string match *-cygwin $::env(SQLITE_TEST_BUILD)]} {
+    append myopts {case "$1" in sqlite3|testfixture|fuzzcheck|fuzzcheck-asan|fuzzcheck-ubsan|sessionfuzz) set -- "$1.exe";; esac}
+    append myopts "\n"
+  }
   if {[info exists ::env(OPTS)]} {
     append myopts "# From environment variable:\n"
     append myopts "OPTS=\"$::env(OPTS)\"\n\n"
   }
diff --git a/test/testrunner.tcl b/test/testrunner.tcl
