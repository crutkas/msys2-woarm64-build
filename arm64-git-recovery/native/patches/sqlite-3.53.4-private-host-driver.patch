diff --git a/autosetup/proj.tcl b/autosetup/proj.tcl
--- a/autosetup/proj.tcl
+++ b/autosetup/proj.tcl
@@ -1629,7 +1629,14 @@
   lappend shBody "exit"
   set shBody [join $shBody "\n"]
   #puts "shBody=$shBody\n"; exit
-  eval [exec echo $shBody | sh]
+  set bridge [file join [pwd] "conftest__tcl-config-[pid].sh"]
+  writefile $bridge $shBody
+  set status [catch {exec sh $bridge} result options]
+  file delete $bridge
+  if {$status} {
+    return -options $options $result
+  }
+  eval $result
 }
 
