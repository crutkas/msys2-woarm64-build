+/* re__strlen():
+ *	Count screen cells, including literal markers and filler columns.
+ */
+static size_t
+re__strlen(const wint_t *s)
+{
+	const wint_t *p = s;
+
+	while (*p)
+		p++;
+	return (size_t)(p - s);
