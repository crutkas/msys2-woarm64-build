pkgbase=gettext
pkgname=('libintl' 'libasprintf')
pkgver=0.22.5
pkgrel=1
pkgdesc='GNU internationalization runtime libraries'
arch=('aarch64')
url='https://www.gnu.org/software/gettext/'
license=('spdx:LGPL-2.1-or-later')
options=('!strip' '!debug' '!lto' '!ccache' '!purge')
source=('payload.tar' 'payload-files.sha256')
sha256sums=('@PAYLOAD_SHA256@' '@FILES_SHA256@')

prepare() {
    cd "$srcdir"
    sha256sum --check --strict payload-files.sha256
}

package_libintl() {
    pkgdesc='GNU Internationalization runtime library'
    depends=('gcc-libs' 'libiconv')
    license=('spdx:LGPL-2.1-or-later')

    install -Dm755 "$srcdir/payload/usr/bin/msys-intl-8.dll" \
        "$pkgdir/usr/bin/msys-intl-8.dll"
    install -Dm644 "$srcdir/payload/licenses/libintl/COPYING.LIB" \
        "$pkgdir/usr/share/licenses/libintl/COPYING.LIB"
}

package_libasprintf() {
    pkgdesc='C-style formatted output in C++ (runtime)'
    depends=('gcc-libs')
    license=('spdx:LGPL-2.1-or-later')

    install -Dm755 "$srcdir/payload/usr/bin/msys-asprintf-0.dll" \
        "$pkgdir/usr/bin/msys-asprintf-0.dll"
    install -Dm644 "$srcdir/payload/licenses/libasprintf/COPYING.LIB" \
        "$pkgdir/usr/share/licenses/libasprintf/COPYING.LIB"
}
