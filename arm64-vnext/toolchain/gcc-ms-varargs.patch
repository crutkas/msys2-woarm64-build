diff --git a/gcc/testsuite/gcc.target/aarch64/ms-abi-varargs.c b/gcc/testsuite/gcc.target/aarch64/ms-abi-varargs.c
new file mode 100644
--- /dev/null
+++ b/gcc/testsuite/gcc.target/aarch64/ms-abi-varargs.c
@@ -0,0 +1,75 @@
+/* { dg-do run { target aarch64*-*-mingw* } } */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+_Static_assert (__builtin_types_compatible_p (__builtin_va_list, char *),
+                "Microsoft va_list must be a pointer");
+
+struct pair { unsigned long long a, b; };
+struct hfa { double a, b, c; };
+
+__attribute__((noinline, noclone))
+static void
+check_slots (int marker, ...)
+{
+  va_list ap, copy;
+  va_start (ap, marker);
+  va_copy (copy, ap);
+  for (int i = 1; i <= 6; ++i)
+    if (va_arg (ap, int) != i)
+      abort ();
+  struct pair p = va_arg (ap, struct pair);
+  struct hfa h = va_arg (ap, struct hfa);
+  if (p.a != 7 || p.b != 8 || h.a != 9.0 || h.b != 10.0 || h.c != 11.0
+      || va_arg (ap, double) != 12.5 || va_arg (copy, int) != 1)
+    abort ();
+  va_end (copy);
+  va_end (ap);
+}
+
+__attribute__((noinline, noclone))
+static void
+check_named_double (double named, ...)
+{
+  va_list ap;
+  va_start (ap, named);
+  if (named != 4.5 || va_arg (ap, int) != 17 || va_arg (ap, double) != 6.5)
+    abort ();
+  va_end (ap);
+}
+
+__attribute__((noinline, noclone))
+static double
+fixed_double (double value)
+{
+  return value + 1.0;
+}
+
+__attribute__((noinline, noclone))
+static void
+check_ucrt (const char *format, ...)
+{
+  char buffer[80];
+  va_list ap;
+  va_start (ap, format);
+  int count = vsnprintf (buffer, sizeof buffer, format, ap);
+  va_end (ap);
+  if (count != 25 || strcmp (buffer, "17 1234567890123 4.5 safe") != 0)
+    abort ();
+}
+
+int
+main (void)
+{
+  struct pair p = { 7, 8 };
+  struct hfa h = { 9.0, 10.0, 11.0 };
+  check_slots (0, 1, 2, 3, 4, 5, 6, p, h, 12.5);
+  check_named_double (4.5, 17, 6.5);
+  if (fixed_double (2.5) != 3.5)
+    abort ();
+  check_ucrt ("%d %llu %.1f %s", 17, 1234567890123ULL, 4.5, "safe");
+  return 0;
+}
