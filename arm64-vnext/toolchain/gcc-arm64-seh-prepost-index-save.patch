+		    && XEXP (XEXP (src, 1), 0) == stack_pointer_rtx
+		    && CONST_INT_P (XEXP (XEXP (src, 1), 1)))
+		  {
+		    seh_emit_save_x (f, seh, dest,
+				     INTVAL (XEXP (XEXP (src, 1), 1)));
+		    emitted = true;
