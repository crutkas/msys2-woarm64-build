 /* Write out the xdata information for one function (arm64).  */
+/* Windows scopes can share a suffix of the prologue or an earlier epilogue.
+   Keep source indices wide while collecting, then compact before encoding.  */
+static void
+seh_arm64_share_epilog_codes (seh_arm64_context *ctx, unsigned int prolog_count,
+			     unsigned int prolog_bytes)
+{
+  seh_arm64_unwind_code *original = ctx->unwind_codes;
+  seh_arm64_unwind_code *compact
+    = XNEWVEC (seh_arm64_unwind_code, ctx->unwind_codes_count);
+  memcpy (compact, original, prolog_count * sizeof (*compact));
+  unsigned int count = prolog_count;
+  unsigned int bytes = prolog_bytes;
+  unsigned int source_start = prolog_count;
+  unsigned int source_bytes = prolog_bytes;
+
+  for (unsigned int scope = 0; scope < ctx->epilogue_scopes_count; ++scope)
+    {
+      unsigned int source_end = source_start;
+      unsigned int end_bytes
+	= scope + 1 < ctx->epilogue_scopes_count
+	  ? ctx->epilogue_scopes[scope + 1].epilogue_start_index
+	  : ctx->unwind_codes_byte_count;
+      while (source_bytes < end_bytes && source_end < ctx->unwind_codes_count)
+	source_bytes += unwind_code_pack_infos[original[source_end++].type].size;
+      unsigned int length = source_end - source_start;
+      unsigned int offset = 0;
+      bool found = false;
+      for (unsigned int start = 0; start + length <= count; ++start)
+	{
+	  unsigned int match = 0;
+	  while (match < length
+		 && compact[start + match].type == original[source_start + match].type
+		 && compact[start + match].value == original[source_start + match].value)
+	    ++match;
+	  if (match == length)
+	    {
+	      found = true;
+	      break;
+	    }
+	  offset += unwind_code_pack_infos[compact[start].type].size;
+	}
+      if (!found)
+	{
+	  offset = bytes;
+	  memcpy (compact + count, original + source_start,
+		  length * sizeof (*compact));
+	  count += length;
+	  for (unsigned int i = source_start; i < source_end; ++i)
+	    bytes += unwind_code_pack_infos[original[i].type].size;
+	}
+      ctx->epilogue_scopes[scope].epilogue_start_index = offset;
+      source_start = source_end;
+    }
+  free (original);
+  ctx->unwind_codes = compact;
+  ctx->unwind_codes_count = count;
+  ctx->unwind_codes_byte_count = bytes;
+}
