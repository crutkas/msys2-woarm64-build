+		      {
+			fprintf (f, "\t.seh_add_fp\t"
+				 HOST_WIDE_INT_PRINT_DEC "\n", increment);
+			emitted = true;
+		      }
+		  }
+		else if (seh->in_epilogue && dest == stack_pointer_rtx
