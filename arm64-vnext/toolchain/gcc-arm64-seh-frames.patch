+{
+  if (!TARGET_SEH || cfun->is_thunk)
+    return;
+  struct seh_frame_state *seh = cfun->machine->seh;
+  gcc_assert (seh && seh->after_prologue && !seh->in_epilogue);
+  seh->in_epilogue = true;
+  fputs ("\t.seh_startepilogue\n", f);
+}
+
 /* Emit assembler directives to reconstruct the SEH state.  */
 
 void
@@ -1022,6 +1034,10 @@ mingw_pe_seh_fini (FILE *f, bool cold)
