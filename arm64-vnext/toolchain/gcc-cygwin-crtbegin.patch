diff --git a/libgcc/config/i386/cygming-crtbegin.c b/libgcc/config/i386/cygming-crtbegin.c
--- a/libgcc/config/i386/cygming-crtbegin.c
+++ b/libgcc/config/i386/cygming-crtbegin.c
@@ -111,6 +111,16 @@
 extern void __gcc_register_frame (void);
 extern void __gcc_deregister_frame (void);
 
+#if DEFAULT_USE_CXA_ATEXIT && defined(__CYGWIN__)
+extern int __cxa_atexit (void (*) (void *), void *, void *);
+
+static void
+deregister_frame_at_exit (void *argument __attribute__((unused)))
+{
+  __gcc_deregister_frame ();
+}
+#endif
+
 void
 __gcc_register_frame (void)
 {
@@ -147,7 +157,7 @@
      at object construction,  also use atexit to register eh frame
      info cleanup.  */
 #ifdef __CYGWIN__
-  __cxa_atexit(__gcc_deregister_frame, NULL, (void *)&__dso_handle);
+  __cxa_atexit(deregister_frame_at_exit, NULL, (void *)&__dso_handle);
 #else
   atexit(__gcc_deregister_frame);
 #endif /* __CYGWIN__ */
