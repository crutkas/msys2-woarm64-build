+        $rejected = $true
+    }
+    if (-not $rejected -or (Test-Path -LiteralPath $contextOutput)) {
+        throw 'Unqualified input must not reach MSYS package execution.'
+    }
+    'PASS: unqualified compiler cannot reach package runner or create output'
+} finally {
