diff --git a/patches/makepkg/mingwarm64.conf b/patches/makepkg/mingwarm64.conf
new file mode 100644
index 0000000000000000000000000000000000000000..34324598af5aa99a8f311c6a50c0618aedb7aa77
--- /dev/null
+++ b/patches/makepkg/mingwarm64.conf
@@ -0,0 +1,31 @@
+CARCH="aarch64"
+CHOST="aarch64-w64-mingw32"
+MINGW_CHOST="$CHOST"
+MINGW_PREFIX="/mingwarm64"
+MINGW_PACKAGE_PREFIX="mingw-w64-aarch64"
+CC="gcc"
+CXX="g++"
+CPPFLAGS=
+CFLAGS="-march=armv8-a -mtune=generic -O2 -pipe -Wp,-D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wp,-D__USE_MINGW_ANSI_STDIO=1"
+CXXFLAGS="$CFLAGS -static-libstdc++"
+LDFLAGS=""
+RUSTFLAGS="-Cforce-frame-pointers=yes"
+
+case "${FLAVOR:-NATIVE_WITH_NATIVE}" in
+  NATIVE_WITH_NATIVE)
+    # Do not add the x64 bootstrap roots to the native compiler search path.
+    ;;
+  NATIVE_WITH_CROSS)
+    CC="$CHOST-gcc"
+    CXX="$CHOST-g++"
+    export RC="$CHOST-windres" WINDRES="$CHOST-windres"
+    export RANLIB="$CHOST-ranlib" STRIP="$CHOST-strip"
+    export OBJDUMP="$CHOST-objdump" OBJCOPY="$CHOST-objcopy"
+    # makepkg also invokes bare strip/objcopy; use the target binutils aliases.
+    export PATH="/opt/$CHOST/bin:/opt/bin:/mingw64/bin:$PATH"
+    ;;
+  *)
+    printf 'Unsupported MINGWARM64 build flavor: %s\n' "$FLAVOR" >&2
+    exit 1
+    ;;
+esac
