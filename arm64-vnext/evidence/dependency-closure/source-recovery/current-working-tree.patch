+        if (-not (Test-Path -LiteralPath "$prefix\$file" -PathType Leaf)) { throw "Required PCRE2 payload missing: $file" }
+    }
+    $pcreDlls = foreach ($library in '8', '16', '32', 'posix') {
+        foreach ($suffix in '.a', '.dll.a') {
+            if (-not (Test-Path -LiteralPath "$prefix\lib\libpcre2-$library$suffix" -PathType Leaf)) {
+                throw "Required PCRE2 static/import library missing: $library$suffix"
+            }
+        }
+        $dll = @(Get-ChildItem -LiteralPath "$prefix\bin" -Filter "libpcre2-$library-*.dll" -File)
+        if ($dll.Count -ne 1) { throw "Expected one PCRE2 $library DLL." }
+        $dll[0].Name
+    }
+    $payload = @(Get-CohortInventory $prefix)
+    $report.PayloadFiles = $payload
+    $report.PackageMetadata = @('.PKGINFO', '.BUILDINFO', '.MTREE' | ForEach-Object {
+        @{ Path = "$output\package\$_"; SHA256 = (Get-FileHash -LiteralPath "$output\package\$_").Hash.ToLowerInvariant() }
+    })
+    foreach ($image in Get-ChildItem -LiteralPath $prefix -Recurse -File | Where-Object Extension -In '.exe', '.dll') {
+        Add-ReadbackImage $image.FullName
+    }
+    $providers = @(Get-Content -LiteralPath $DependencyArchives -Raw | ConvertFrom-Json)
+    $report.DependencyArchives = $providers
+    for ($i = 0; $i -lt $providers.Count; $i++) {
+        $provider = $providers[$i]
+        if ((Get-FileHash -LiteralPath $provider.Path).Hash.ToLowerInvariant() -cne $provider.SHA256) {
+            throw 'An admitted dependency archive changed.'
+        }
+        $extract = "$output\provider-$i"
+        New-Item -ItemType Directory -Path $extract | Out-Null
+        & "$env:SystemRoot\System32\tar.exe" -xf $provider.Path -C $extract
+        if ($LASTEXITCODE -ne 0) { throw 'Dependency extraction failed.' }
+        foreach ($image in Get-ChildItem -LiteralPath "$extract\mingwarm64\bin" -File |
+            Where-Object { $_.Extension -eq '.dll' -or $_.Name -eq 'bzip2.exe' }) {
+            $destination = Join-Path $dependencies $image.Name
+            if (Test-Path -LiteralPath $destination) { throw "Duplicate dependency image: $($image.Name)" }
+            Copy-Item -LiteralPath $image.FullName -Destination $destination
+            Add-ReadbackImage $destination
+        }
+    }
+    foreach ($name in 'edit.dll', 'libbz2-1.dll', 'zlib1.dll', 'bzip2.exe') {
+        if (-not (Test-Path -LiteralPath "$dependencies\$name" -PathType Leaf)) { throw "Required admitted dependency missing: $name" }
+    }
+    $dependencyPayload = @(Get-CohortInventory $dependencies)
+    $report.DependencyImages = $dependencyPayload
+    $configuration = Invoke-Readback 'configuration' "$prefix\bin\pcre2test.exe" @('-C')
+    $configurationText = [IO.File]::ReadAllText($configuration.Stdout)
+    foreach ($feature in '8-bit support', '16-bit support', '32-bit support', 'UTF and UCP support',
