+        $run = Invoke-Readback "live-jit-$width" "$prefix\bin\pcre2test.exe" @('-q', "-$width", '-jitfast') $testInput (@($pcreDlls) + 'edit.dll')
+        if ([IO.File]::ReadAllText($run.Stdout) -notmatch '(?m)^\s*0: foo\r?$') { throw "Extracted $width-bit direct JIT matching failed." }
+    }
+    $grepInput = [Text.Encoding]::ASCII.GetBytes("native-pcre2`nnot-a-match`n")
+    $grepDlls = @($pcreDlls | Where-Object { $_ -like 'libpcre2-8-*' }) + @('libbz2-1.dll', 'zlib1.dll')
+    $grep = Invoke-Readback 'live-grep' "$prefix\bin\pcre2grep.exe" @('-e', '^native-pcre2$') $grepInput $grepDlls
+    if ([IO.File]::ReadAllText($grep.Stdout).Trim() -cne 'native-pcre2') { throw 'Extracted pcre2grep matching failed.' }
+    $compressed = Invoke-Readback 'bzip2-fixture' "$dependencies\bzip2.exe" @('-c') $grepInput @('libbz2-1.dll')
+    Copy-Item -LiteralPath $compressed.Stdout -Destination "$output\input.bz2"
+    $file = [IO.File]::Create("$output\input.gz")
+    $gzip = [IO.Compression.GZipStream]::new($file, [IO.Compression.CompressionLevel]::Optimal)
+    try { $gzip.Write($grepInput, 0, $grepInput.Length) } finally { $gzip.Dispose(); $file.Dispose() }
+    foreach ($extension in 'gz', 'bz2') {
+        $run = Invoke-Readback "grep-$extension" "$prefix\bin\pcre2grep.exe" @('-e', '^native-pcre2$', "$output\input.$extension")
+        if ([IO.File]::ReadAllText($run.Stdout).Trim() -cne 'native-pcre2') { throw "Native pcre2grep $extension support failed." }
+    }
+    $null = Invoke-Readback 'invalid-pattern' "$prefix\bin\pcre2grep.exe" @('-e', '[') -ExpectedExit 2
+
+    $compiler = Join-Path $buildResult.After.Prefix 'bin\gcc.exe'
+    $report.ConsumerCompiler = & "$PSScriptRoot\assert-arm64-pe.ps1" -Path $compiler | ConvertFrom-Json
+    foreach ($mode in 'static', 'shared') {
+        $suffix = if ($mode -eq 'static') { '.a' } else { '.dll.a' }
+        $flags = @('-O2', "-I$prefix\include")
+        if ($mode -eq 'static') { $flags += '-DPCRE2_STATIC' }
+        $jit = "$output\consumers\jit-$mode.exe"
+        $jitLibraries = @('8', '16', '32' | ForEach-Object { "$prefix\lib\libpcre2-$_$suffix" })
+        $null = Invoke-Readback "compile-jit-$mode" $compiler ($flags + @('-DSUPPORT_PCRE2_8', '-DSUPPORT_PCRE2_16', '-DSUPPORT_PCRE2_32',
+            "$SourceDirectory\src\pcre2_jit_test.c") + $jitLibraries + @('-o', $jit)) -TimeoutSeconds 600
+        Add-ReadbackImage $jit
+        $run = Invoke-Readback "upstream-jit-$mode" $jit
+        $text = [IO.File]::ReadAllText($run.Stdout)
+        foreach ($width in 8, 16, 32) {
+            if ($text -notmatch "in\s+$width bit mode with UTF-$width\s+enabled") {
+                throw "Upstream $mode JIT tests did not exercise Unicode width $width."
+            }
+        }
+        $locale = "$output\consumers\locale-$mode.exe"
+        $null = Invoke-Readback "compile-locale-$mode" $compiler ($flags + @($localeSource,
+            "$prefix\lib\libpcre2-8$suffix", '-o', $locale)) -TimeoutSeconds 600
+        Add-ReadbackImage $locale
+        $run = Invoke-Readback "locale-$mode" $locale
+        if (-not [IO.File]::ReadAllText($run.Stdout).Contains('512 independent CRT comparisons, 0 failures')) {
+            throw "The independent $mode POSIX alpha regression did not complete."
+        }
+        $posix = "$output\consumers\posix-$mode.exe"
+        if ($mode -eq 'shared') { $flags += '-DPCRE2POSIX_SHARED' }
+        $null = Invoke-Readback "compile-posix-$mode" $compiler ($flags + @("$SourceDirectory\src\pcre2posix_test.c",
+            "$prefix\lib\libpcre2-posix$suffix", "$prefix\lib\libpcre2-8$suffix", '-o', $posix)) -TimeoutSeconds 600
+        Add-ReadbackImage $posix
+        $null = Invoke-Readback "upstream-posix-$mode" $posix @('-v')
+    }
+    Assert-CohortInventory $prefix $payload
+    Assert-CohortInventory $dependencies $dependencyPayload
+    foreach ($name in $sourcePins.Keys) {
+        if ((Get-FileHash -LiteralPath "$SourceDirectory\src\$name").Hash.ToLowerInvariant() -cne $sourcePins[$name]) {
+            throw "Upstream readback test changed during execution: $name"
+        }
+    }
+    if ((Get-FileHash -LiteralPath $localeSource).Hash.ToLowerInvariant() -cne $localeSourceHash) {
+        throw 'The locale regression source changed during readback.'
+    }
+    foreach ($archive in @($package) + $providers) {
+        if ((Get-FileHash -LiteralPath $archive.Path).Hash.ToLowerInvariant() -cne $archive.SHA256) {
+            throw 'A package archive changed during extracted readback.'
+        }
+    }
+    foreach ($metadata in $report.PackageMetadata) {
+        if ((Get-FileHash -LiteralPath $metadata.Path).Hash.ToLowerInvariant() -cne $metadata.SHA256) {
+            throw 'Extracted PCRE2 package metadata changed during readback.'
+        }
+    }
+    $after = & "$PSScriptRoot\test-qualified-header-delta.ps1" -Prefix $buildResult.After.Prefix -Manifest $HeaderDeltaManifest
+    if ($after.Epoch -cne $buildResult.After.Epoch) { throw 'Qualified compiler inputs changed during extracted-package readback.' }
+    $report.After = $after
+    $report.Status = 'native-pcre2-full-profile-extracted-package-readback-passed'
+} finally {
+    $report.CompletedAt = [DateTime]::UtcNow.ToString('o')
+    $report | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath "$output\readback.json"
+}
+$report.Status
