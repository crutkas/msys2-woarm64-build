+    bash "$(cygpath -u "${WOARM64_NATIVE_EXEC:?}")" "$srcdir/control/native-iconv-consumer.exe" "$(cygpath -am "$srcdir/control/status")"
+    test -s "$srcdir/control/status/ready"
