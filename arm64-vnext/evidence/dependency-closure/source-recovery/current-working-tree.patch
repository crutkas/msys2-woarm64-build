+        if (-not $configurationText.Contains($feature)) { throw "Required PCRE2 capability missing: $feature" }
+    }
+    if ($configurationText -notmatch 'Architecture:.*ARM-64') { throw 'JIT did not identify the native ARM64 backend.' }
