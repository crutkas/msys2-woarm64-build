pkgbase=libiconv-bootstrap
pkgname=('libiconv' 'iconv-bootstrap' 'libiconv-devel')
pkgver=1.19
pkgrel=1
pkgdesc='Source-built native ARM64 MSYS iconv/charset libraries; CLI bootstrap split is NLS-disabled'
arch=('aarch64')
url='https://www.gnu.org/software/libiconv/'
license=('GPL-3.0-only' 'LGPL-2.1-only')
options=('!strip' '!debug' '!lto' '!ccache' 'staticlibs' '!libtool' '!purge' '!zipman')
source=('payload.tar' 'payload-files.sha256' 'provenance.tar' 'control.tar')
sha256sums=('@PAYLOAD_SHA256@' '@FILES_SHA256@' '@PROVENANCE_SHA256@' '@CONTROL_SHA256@')

prepare() {
    cd "$srcdir"
    sha256sum --check --strict payload-files.sha256
}

check() {
    cp "$srcdir/payload/usr/bin/msys-iconv-2.dll" "$srcdir/payload/usr/bin/msys-charset-1.dll" "$srcdir/control/"
    mkdir "$srcdir/control/status"
    touch "$srcdir/control/status/continue"
    bash "$(cygpath -u "${WOARM64_NATIVE_EXEC:?}")" "$srcdir/control/native-iconv-consumer.exe" "$(cygpath -am "$srcdir/control/status")"
    test -s "$srcdir/control/status/ready"
}

package_libiconv() {
    pkgdesc='Native ARM64 MSYS iconv and charset conversion libraries'
    depends=('gcc-libs' 'msys2-runtime')
    install -dm755 "$pkgdir/usr/bin"
    cp -a "$srcdir/payload/usr/bin/msys-iconv-2.dll" "$srcdir/payload/usr/bin/msys-charset-1.dll" "$pkgdir/usr/bin/"
    cp -a "$srcdir/payload/usr/share" "$pkgdir/usr/"
    install -dm755 "$pkgdir/usr/share/woarm64-package-provenance/libiconv"
    cp -a "$srcdir/provenance/." "$pkgdir/usr/share/woarm64-package-provenance/libiconv/"
}

package_iconv-bootstrap() {
    pkgdesc='Native ARM64 MSYS iconv bootstrap CLI; NLS disabled pending native libintl and CLI rebuild'
    depends=('gcc-libs' 'msys2-runtime' "libiconv=${pkgver}")
    conflicts=('iconv')
    install -Dm755 "$srcdir/payload/usr/bin/iconv.exe" "$pkgdir/usr/bin/iconv.exe"
}

package_libiconv-devel() {
    pkgdesc='Native ARM64 MSYS iconv headers/libraries with explicit bootstrap CLI dependency'
    depends=("libiconv=${pkgver}" "iconv-bootstrap=${pkgver}")
    install -dm755 "$pkgdir/usr"
    cp -a "$srcdir/payload/usr/include" "$srcdir/payload/usr/lib" "$pkgdir/usr/"
}
