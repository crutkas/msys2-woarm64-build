pkgname=mingw-w64-aarch64-pkgconf
pkgver=3.0.5
pkgrel=1
pkgdesc='Source-built native ARM64 pkgconf and tools with preserved producer lineage'
arch=('aarch64')
url='https://github.com/pkgconf/pkgconf'
license=('ISC')
provides=("mingw-w64-aarch64-pkg-config=${pkgver}")
options=('!strip' '!debug' '!lto' 'libtool' '!purge' '!zipman')
source=('payload.tar' 'payload-files.sha256' 'provenance.tar')
sha256sums=('@PAYLOAD_SHA256@' '@FILES_SHA256@' '@PROVENANCE_SHA256@')

prepare() {
    cd "$srcdir"
    sha256sum --check --strict payload-files.sha256
}

check() {
    "$srcdir/payload/bin/pkgconf.exe" --version | grep -Fx '3.0.5'
    local prefix
    prefix=$(PKG_CONFIG_LIBDIR="$(cygpath -m "$srcdir/payload/lib/pkgconfig")" \
        "$srcdir/payload/bin/pkgconf.exe" --variable=prefix libpkgconf)
    [[ $prefix == "$(cygpath -m "$srcdir/payload")" ]]
}

package() {
    install -dm755 "$pkgdir/mingwarm64"
    cp -a "$srcdir/payload/." "$pkgdir/mingwarm64/"
    install -dm755 "$pkgdir/mingwarm64/share/woarm64-package-provenance/pkgconf"
    cp -a "$srcdir/provenance/." "$pkgdir/mingwarm64/share/woarm64-package-provenance/pkgconf/"
    install -m644 "$srcdir/payload-files.sha256" "$pkgdir/mingwarm64/share/woarm64-package-provenance/pkgconf/"
}
