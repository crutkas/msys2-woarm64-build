"""Run shipped native MSYS less through the existing bounded openpty protocol."""
import argparse
import ctypes as c
from ctypes import wintypes as w
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import sys
import time


RUNTIME_SHA = "907afa099a69aa3c13d4e3b30eeba18c4a6b1766d5fa39b4746fae23c3f9e76c"


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def identity(pid, root, required):
    class Machine(c.Structure):
        _fields_ = [("machine", w.WORD), ("reserved", w.WORD), ("attributes", w.DWORD)]

    class Module(c.Structure):
        _fields_ = [("size", w.DWORD), ("id", w.DWORD), ("pid", w.DWORD),
                    ("global_count", w.DWORD), ("process_count", w.DWORD),
                    ("base", c.c_void_p), ("base_size", w.DWORD), ("handle", w.HMODULE),
                    ("name", w.WCHAR * 256), ("path", w.WCHAR * 260)]

    kernel = c.WinDLL("kernel32", use_last_error=True)
    kernel.OpenProcess.argtypes = [w.DWORD, w.BOOL, w.DWORD]
    kernel.OpenProcess.restype = w.HANDLE
    kernel.GetProcessInformation.argtypes = [w.HANDLE, c.c_int, c.c_void_p, w.DWORD]
    kernel.GetProcessTimes.argtypes = [w.HANDLE] + [c.POINTER(w.FILETIME)] * 4
    kernel.CloseHandle.argtypes = [w.HANDLE]
    kernel.CreateToolhelp32Snapshot.argtypes = [w.DWORD, w.DWORD]
    kernel.CreateToolhelp32Snapshot.restype = w.HANDLE
    kernel.Module32FirstW.argtypes = [w.HANDLE, c.POINTER(Module)]
    kernel.Module32NextW.argtypes = [w.HANDLE, c.POINTER(Module)]
    process = kernel.OpenProcess(0x1000, False, pid)
    if not process:
        raise c.WinError(c.get_last_error())
    try:
        machine = Machine()
        if not kernel.GetProcessInformation(process, 9, c.byref(machine), c.sizeof(machine)):
            raise c.WinError(c.get_last_error())
        if machine.machine != 0xAA64:
            raise RuntimeError(f"Actual ProcessMachine9 is 0x{machine.machine:04x}, not AA64")
        created, ended, kernel_time, user_time = (w.FILETIME() for _ in range(4))
        if not kernel.GetProcessTimes(process, c.byref(created), c.byref(ended),
                                      c.byref(kernel_time), c.byref(user_time)):
            raise c.WinError(c.get_last_error())
        birth = (created.dwHighDateTime << 32) | created.dwLowDateTime
    finally:
        kernel.CloseHandle(process)
    snapshot = kernel.CreateToolhelp32Snapshot(0x18, pid)
    if snapshot == c.c_void_p(-1).value:
        raise c.WinError(c.get_last_error())
    modules = []
    item = Module()
    item.size = c.sizeof(item)
    try:
        more = kernel.Module32FirstW(snapshot, c.byref(item))
        if not more:
            raise c.WinError(c.get_last_error())
        while more:
            path = Path(item.path)
            system = path.is_relative_to(Path(os.environ["SystemRoot"]) / "System32") or path.is_relative_to(
                Path(os.environ["SystemRoot"]) / "WinSxS")
            if not system and not path.is_relative_to(root):
                raise RuntimeError(f"Unexpected loaded module outside private native root: {path}")
            modules.append({"name": item.name, "path": str(path), "sha256": digest(path), "system": system})
            more = kernel.Module32NextW(snapshot, c.byref(item))
        if c.get_last_error() != 18:
            raise c.WinError(c.get_last_error())
    finally:
        kernel.CloseHandle(snapshot)
    for name, expected in required.items():
        found = [item for item in modules if item["name"].lower() == name.lower()]
        if len(found) != 1 or found[0]["sha256"] != expected:
            raise RuntimeError(f"Required live DLL did not match: {name}")
    return {"pid": pid, "creation_filetime": birth, "ProcessMachine9": f"0x{machine.machine:04X}", "modules": modules}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--mode", choices=("positive-control", "text", "large"), required=True)
    parser.add_argument("--fixture", type=Path, required=True)
    parser.add_argument("--bounded-helper", type=Path, required=True)
    parser.add_argument("--bounded-helper-sha", required=True)
    args = parser.parse_args()
    if args.output.exists():
        raise RuntimeError("PTY result directory must be new")
    args.output.mkdir(parents=True)
    if digest(args.bounded_helper) != args.bounded_helper_sha:
        raise RuntimeError("Existing bounded process helper changed")
    spec = importlib.util.spec_from_file_location("bounded_process", args.bounded_helper)
    bounded = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(bounded)
    root = args.root.resolve()
    binary = root / "usr/bin"
    if digest(binary / "msys-2.0.dll") != RUNTIME_SHA:
        raise RuntimeError("Private runtime differs from the required907 cohort")
    for folder in ("home", "temp"):
        (args.output / folder).mkdir()
    environment = {
        "SystemRoot": os.environ["SystemRoot"], "WINDIR": os.environ["SystemRoot"],
        "COMSPEC": os.environ["SystemRoot"] + r"\System32\cmd.exe", "PATHEXT": ".COM;.EXE;.BAT;.CMD",
        "PATH": str(binary) + ";" + os.environ["SystemRoot"] + r"\System32",
        "HOME": str(args.output / "home"), "USERPROFILE": str(args.output / "home"),
        "TEMP": str(args.output / "temp"), "TMP": str(args.output / "temp"),
        "TERM": "xterm-256color", "LC_ALL": "C.UTF-8",
        "TERMINFO": str(root / "usr/share/terminfo"), "LESSHISTFILE": "-",
    }
    control = args.mode == "positive-control"
    required = {"msys-2.0.dll": RUNTIME_SHA, "msys-ncursesw6.dll": digest(binary / "msys-ncursesw6.dll")}
    if control:
        required["msys-ncurses++w6.dll"] = digest(binary / "msys-ncurses++w6.dll")
        command = [str(binary / "editor-pty.exe"), str(binary / "probe.exe"),
                   str(args.output / "api.json"), "curses"]
        ready_name, result_name = "editor-ready.json", "api.json"
    else:
        required["msys-pcre2-8-0.dll"] = digest(binary / "msys-pcre2-8-0.dll")
        command = [str(binary / "native-less-pty.exe"), str(binary / "less.exe"), str(args.fixture), args.mode]
        ready_name, result_name = "pager-ready.json", "pty-result.json"
    report = {"status": "failed", "mode": args.mode, "root": str(root), "environment": environment,
              "command": command, "fixture": str(args.fixture),
              "fixture_size": args.fixture.stat().st_size, "bounded_helper_sha256": args.bounded_helper_sha,
              "product_sha256": digest(binary / ("probe.exe" if control else "less.exe")),
              "required_modules": required}

    def observe(parent_pid):
        ready = args.output / ready_name
        deadline = time.monotonic() + 40
        while not ready.exists() and time.monotonic() < deadline:
            time.sleep(0.02)
        if not ready.exists():
            raise RuntimeError("Native PTY target did not reach readiness")
        child_pid = json.loads(ready.read_text())["windows_pid"]
        report["controller"] = identity(parent_pid, root, {"msys-2.0.dll": RUNTIME_SHA})
        report["pager"] = identity(child_pid, root, required)
        (args.output / "live-modules.json").write_text(json.dumps(report, indent=2) + "\n")
        (args.output / "continue").write_bytes(b"go\n")

    kernel = c.WinDLL("kernel32", use_last_error=True)
    kernel.SetErrorMode.argtypes = [w.UINT]
    kernel.SetErrorMode.restype = w.UINT
    previous = kernel.SetErrorMode(0x8003)
    try:
        with (args.output / "controller.log").open("xb") as log:
            report["process"] = bounded.run(command, cwd=args.output, env=environment, log=log,
                                             timeout=240, on_started=observe, drain_grace=3)
        if not report["process"]["passed"]:
            raise RuntimeError("Native PTY controller failed")
        report["assertions"] = json.loads((args.output / result_name).read_text())
        if not report["assertions"]["passed"]:
            raise RuntimeError("Native pager assertions failed")
        report["transcript_sha256"] = digest(args.output / "pty-output.bin")
        report["status"] = "native-PTY-and-907-live-contract-passed"
    finally:
        kernel.SetErrorMode(previous)
        (args.output / "result.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps({"status": report["status"], "mode": args.mode, "output": str(args.output),
                      "assertions": report["assertions"]}))


if __name__ == "__main__":
    main()
