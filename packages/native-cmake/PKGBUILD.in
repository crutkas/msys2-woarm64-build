pkgname=mingw-w64-aarch64-cmake
pkgver=4.4.3
pkgrel=1
pkgdesc='Official Kitware Windows ARM64 CMake CLI bootstrap package (not a Clang toolchain)'
arch=('aarch64')
url='https://cmake.org/'
license=('BSD-3-Clause')
options=('!strip' '!debug' '!lto' 'libtool' '!purge' '!zipman')
source=('payload.tar' 'payload-files.sha256' 'provenance.tar')
sha256sums=('@PAYLOAD_SHA256@' '@FILES_SHA256@' '@PROVENANCE_SHA256@')

prepare() {
    cd "$srcdir"
    sha256sum --check --strict payload-files.sha256
}

check() {
    "$srcdir/payload/bin/cmake.exe" --version | grep -Fx 'cmake version 4.4.3'
    "$srcdir/payload/bin/ctest.exe" --version | grep -Fx 'ctest version 4.4.3'
}

package() {
    install -dm755 "$pkgdir/mingwarm64"
    cp -a "$srcdir/payload/." "$pkgdir/mingwarm64/"
    install -dm755 "$pkgdir/mingwarm64/share/licenses/cmake"
    install -m644 "$srcdir/payload/doc/cmake/LICENSE.rst" "$pkgdir/mingwarm64/share/licenses/cmake/"
    install -dm755 "$pkgdir/mingwarm64/share/woarm64-package-provenance/cmake"
    cp -a "$srcdir/provenance/." "$pkgdir/mingwarm64/share/woarm64-package-provenance/cmake/"
    install -m644 "$srcdir/payload-files.sha256" "$pkgdir/mingwarm64/share/woarm64-package-provenance/cmake/"
}
