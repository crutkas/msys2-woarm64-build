pkgbase=libxcrypt
pkgname=('libxcrypt' 'libxcrypt-devel')
pkgver=4.5.2
pkgrel=1
pkgdesc='Source-built native ARM64 MSYS libxcrypt with complete upstream and installed-consumer evidence'
arch=('aarch64')
url='https://github.com/besser82/libxcrypt/'
license=('LGPL-2.1-or-later')
options=('!strip' '!debug' '!lto' '!ccache' 'staticlibs' 'libtool' '!purge' '!zipman')
source=('payload.tar' 'payload-files.sha256' 'provenance.tar' 'control.tar')
sha256sums=('@PAYLOAD_SHA256@' '@FILES_SHA256@' '@PROVENANCE_SHA256@' '@CONTROL_SHA256@')

prepare() {
    cd "$srcdir"
    sha256sum --check --strict payload-files.sha256
}

check() {
    cp "$srcdir/payload/usr/bin/msys-crypt-2.dll" "$srcdir/control/"
    mkdir "$srcdir/control/status"
    touch "$srcdir/control/status/continue"
    bash "$(cygpath -u "${WOARM64_NATIVE_EXEC:?}")" "$srcdir/control/native-crypt-consumer.exe" "$(cygpath -am "$srcdir/control/status")"
    test -s "$srcdir/control/status/ready"
}

package_libxcrypt() {
    depends=('msys2-runtime')
    install -Dm755 "$srcdir/payload/usr/bin/msys-crypt-2.dll" "$pkgdir/usr/bin/msys-crypt-2.dll"
    install -dm755 "$pkgdir/usr/share/woarm64-package-provenance/libxcrypt"
    cp -a "$srcdir/provenance/." "$pkgdir/usr/share/woarm64-package-provenance/libxcrypt/"
}

package_libxcrypt-devel() {
    pkgdesc='Native ARM64 MSYS libxcrypt static library, import library, headers and documentation'
    depends=("libxcrypt=${pkgver}")
    conflicts=('libcrypt-devel')
    provides=('libcrypt-devel')
    replaces=('libcrypt-devel')
    install -dm755 "$pkgdir/usr"
    cp -a "$srcdir/payload/usr/include" "$srcdir/payload/usr/lib" "$srcdir/payload/usr/share" "$pkgdir/usr/"
}
