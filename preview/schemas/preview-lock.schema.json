{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/msys2-woarm64-build/preview/schemas/preview-lock.schema.json",
  "title": "Portable native ARM64 Git Bash preview lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceDateEpoch",
    "inputs",
    "nativeShellClosure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "nativeShellClosure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^\\\\/:](?:[^\\\\:]*)$"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "status",
        "identity",
        "asset",
        "package",
        "overlay"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "role": {
          "enum": [
            "base",
            "runtime-package",
            "native-shell-package",
            "build-support-package",
            "scanner-tool-package",
            "scanner-script",
            "scanner-host",
            "archive-extractor",
            "authoritative-validator-main",
            "authoritative-validator-support",
            "authoritative-validator-schema",
            "authoritative-runtime-collector",
            "authoritative-runtime-support"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/resolvedIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/resolvedAsset"
            },
            {
              "type": "null"
            }
          ]
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/package"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay": {
          "$ref": "#/$defs/overlay"
        }
      }
    },
    "resolvedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "oneOf": [
        {
          "required": ["tag"],
          "not": { "required": ["sourcePath"] }
        },
        {
          "required": ["sourcePath"],
          "not": { "required": ["tag"] }
        }
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.+-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^[^\\\\/:](?:[^\\\\:]*)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "resolvedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "expectedBytes",
        "sha256",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "expectedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "7z-sfx",
            "pkg.tar.zst",
            "file",
            "portable-executable"
          ]
        },
        "releaseAssetId": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "expectedBytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expectedBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "provides"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mappings"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination",
              "allowOverwrite"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "allowOverwrite": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
