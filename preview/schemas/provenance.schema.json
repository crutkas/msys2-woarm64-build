{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARM64 preview provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockSha256",
    "sourceDateEpoch",
    "nativeShellClosure",
    "assembler",
    "inputs",
    "overlayOrder",
    "replacements",
    "finalMembers",
    "pseudoReloc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lockSha256": { "$ref": "#/$defs/sha256" },
    "sourceDateEpoch": { "type": "integer", "minimum": 1 },
    "nativeShellClosure": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "assembler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "crutkas/msys2-woarm64-build" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "release", "asset", "package", "archiveMembers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "release": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }]
          },
          "asset": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/asset" }]
          },
          "package": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/package" }]
          },
          "archiveMembers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/archiveMember" }
          }
        }
      }
    },
    "overlayOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destinationPath",
          "replacedInputId",
          "replacedSourceMember",
          "winnerInputId",
          "winnerSourceMember"
        ],
        "properties": {
          "destinationPath": { "$ref": "#/$defs/path" },
          "replacedInputId": { "type": "string", "minLength": 1 },
          "replacedSourceMember": { "$ref": "#/$defs/path" },
          "winnerInputId": { "type": "string", "minLength": 1 },
          "winnerSourceMember": { "$ref": "#/$defs/path" }
        }
      }
    },
    "finalMembers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finalMember" }
    },
    "pseudoReloc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destinationPath", "inputId", "sourceMember"],
            "properties": {
              "destinationPath": { "$ref": "#/$defs/path" },
              "inputId": { "type": "string", "minLength": 1 },
              "sourceMember": { "$ref": "#/$defs/path" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\:]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "targetCommit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.+-]+$" },
        "tag": { "type": "string", "minLength": 1 },
        "targetCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourcePath": { "$ref": "#/$defs/path" }
      },
      "oneOf": [
        { "required": ["tag"], "not": { "required": ["sourcePath"] } },
        { "required": ["sourcePath"], "not": { "required": ["tag"] } }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "name", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "personality", "provides"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "personality": { "enum": ["msys", "mingw", "managed", "mixed", "tool"] },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "archiveMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMember",
        "type",
        "bytes",
        "sha256",
        "selected",
        "destinationPath",
        "linkTarget"
      ],
      "properties": {
        "sourceMember": { "$ref": "#/$defs/path" },
        "type": { "enum": ["file", "directory", "symlink", "hardlink"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/nullableSha256" },
        "selected": { "type": "boolean" },
        "destinationPath": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }]
        },
        "linkTarget": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }]
        }
      }
    },
    "finalMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinationPath",
        "inputId",
        "sourceMember",
        "type",
        "bytes",
        "sha256",
        "linkTarget"
      ],
      "properties": {
        "destinationPath": { "$ref": "#/$defs/path" },
        "inputId": { "type": "string", "minLength": 1 },
        "sourceMember": { "$ref": "#/$defs/path" },
        "type": { "enum": ["file", "directory", "symlink", "hardlink"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/nullableSha256" },
        "linkTarget": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }]
        }
      }
    }
  }
}
