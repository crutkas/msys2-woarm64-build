--- a/tests/run-all
+++ b/tests/run-all
@@ -56,6 +56,10 @@
 
 echo Any output from any test, unless otherwise noted, indicates a possible anomaly
 
+: "${BASH_TEST_EVIDENCE:?Owned test evidence directory is required}"
+mkdir -p "$BASH_TEST_EVIDENCE" || exit 1
+overall=0
+: > "$BASH_TEST_EVIDENCE/results.tsv" || exit 1
 for x in run-*
 do
 	case $x in
@@ -63,7 +67,17 @@
-	$0|run-minimal|run-gprof)	;;
+	$0|run-all|./run-all|run-minimal|run-gprof)	;;
 	*.orig|*~) ;;
-	*)	echo $x ; sh $x ; rm -f ${BASH_TSTOUT} ;;
+	*)	echo "$x"
+		case_status=0
+		sh "$x" >"$BASH_TEST_EVIDENCE/$x.log" 2>&1 || case_status=$?
+		cat "$BASH_TEST_EVIDENCE/$x.log" || overall=1
+		printf '%s\t%s\n' "$x" "$case_status" >> "$BASH_TEST_EVIDENCE/results.tsv" || overall=1
+		if test -f "$BASH_TSTOUT"; then
+			cp "$BASH_TSTOUT" "$BASH_TEST_EVIDENCE/$x.output" || overall=1
+		fi
+		test "$case_status" -eq 0 || overall=1
+		rm -f "$BASH_TSTOUT"
+		;;
 	esac
 done
 
-exit 0
+exit "$overall"
