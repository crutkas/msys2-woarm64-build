 my $server_pem            = srctop_file("test", "ocsp-tests", "server.pem");
 
+sub drain_handles {
+    my (%handles) = @_;
+    my $selector = IO::Select->new(values %handles);
+    my %name_by_fd = map { fileno($handles{$_}) => $_ } keys %handles;
+    my %output = map { $_ => "" } keys %handles;
+
+    while (my @ready = $selector->can_read()) {
+        for my $handle (@ready) {
+            my $fd = fileno($handle);
+            my $buffer;
+            my $length = sysread($handle, $buffer, 8192);
+            die "Unable to read child output: $!" unless defined $length;
+            if ($length == 0) {
+                $selector->remove($handle);
+                close($handle);
+            } else {
+                $output{$name_by_fd{$fd}} .= $buffer;
+            }
+        }
+    }
+
+    return \%output;
+}
