# Staged, not active.
#
# This job is intentionally parked in .github/historical-workflows/ instead of
# .github/workflows/. The ARM64 admission policy is deny-by-default over the
# workflow directory: audit-arm64-workflows.ps1 enumerates .github/workflows for
# *.yml and *.yaml and raises active-workflow-set-mismatch for anything that is
# not already a key of active_workflows, and it raises
# protected-policy-source-binding-mismatch unless the candidate copy of
# .github/policies/arm64-quarantine-policy.json is byte-identical to the
# protected base copy. Adding this file to .github/workflows, editing an
# existing workflow, or editing the policy in the same change would therefore
# fail the arm64-governance required check.
#
# Activating this job is a separately reviewed protected-base change. It needs
# all of the following, applied to the protected base:
#
#   1. Move this file to .github/workflows/native-boundary-tests.yml.
#   2. Add an active_workflows entry keyed
#      ".github/workflows/native-boundary-tests.yml" with:
#        authority: untrusted-diagnostic
#        source: the blob binding (path, raw_path_utf8_base64, mode 100644,
#                object_type blob, byte_length, oid) of the moved file
#        allowed_events: ["pull_request"]
#        allowed_shells: ["bash"]
#        allowed_local_shell_entrypoints:
#          ["tests/bootstrap/run-native-boundary.sh"]
#        allowed_local_shell_sources: the blob binding for that script
#        allowed_inline_shell_sha256: the digests of the two inline run blocks
#   3. Leave every other active_workflows entry untouched, so the existing
#      required check keeps its current bindings.
#
# The suite this job runs needs only bash, coreutils and the Windows subst
# command, so it gives real coverage of the identity, cleanup and argument
# conversion rules on an AMD64 runner while an admitted ARM64 binutils release
# does not exist yet. It never builds a package and never consumes a toolchain
# artifact.

name: Native toolchain boundary tests

on:
  pull_request:
    paths:
      - ".github/scripts/build-package.sh"
      - ".github/scripts/setup-mingwarm64.sh"
      - ".github/scripts/lib/**"
      - "build-native-with-native.sh"
      - "config.sh"
      - "tests/bootstrap/**"

permissions:
  contents: read

jobs:
  boundary:
    name: Diagnostic only - never admission
    runs-on: windows-latest
    steps:
      - name: Checkout pull request head
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false

      - name: Check shell syntax
        shell: bash
        run: |
          set -euo pipefail
          status=0
          while IFS= read -r script; do
            if ! bash -n "$script"; then
              echo "Syntax error in $script" >&2
              status=1
            fi
          done < <(find . -path ./.git -prune -o -name '*.sh' -print)
          exit "$status"

      - name: Run native boundary regressions
        shell: bash
        run: ./tests/bootstrap/run-native-boundary.sh
